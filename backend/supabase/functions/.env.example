# Secrets des Edge Functions — copier en supabase/functions/.env (jamais commité).
# En production : `npx supabase secrets set NOM=valeur`.
# Référence : tontine-pwa/docs/CAHIER-DES-CHARGES-INTEGRATION.md

# --- Application ---
APP_URL=http://localhost:5173
# Origines autorisées (CORS), séparées par des virgules. Par défaut : APP_URL.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# En-tête attendu par cron-daily (appelé par pg_cron).
CRON_SECRET=

# --- Connexion : code SMS et PIN (section 4.1) ---
# Valeurs longues et aléatoires (ex. `openssl rand -base64 48`), différentes entre elles.
OTP_PEPPER=
PIN_PEPPER=
SESSION_PEPPER=
PROOF_TOKEN_SECRET=

# --- Paiement : PayTech (section 4.7) ---
# Clés : espace client PayTech → Paramètres → API. Vides : paiement en ligne désactivé
# (en local seulement, la page de paiement simulée de l'appli prend le relais).
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
# test (débit de 100 à 150 FCFA quel que soit le montant) ou prod. La production exige
# AUSSI « prod » dans Paramètres → Paiement (payment.mode) de l'appli.
PAYTECH_ENV=test
# Facultatif : adresse publique HTTPS de payments-ipn (par défaut SUPABASE_URL/functions/v1/payments-ipn).
# En local, PayTech ne peut pas joindre la machine : utiliser un tunnel HTTPS pour tester.
PAYTECH_IPN_URL=

# --- SMS : Orange SMS Pro Sénégal (section 4.10) ---
# orange (défaut) ou console : en local seulement, le SMS est écrit dans les journaux.
SMS_MODE=orange
ORANGE_BASE_URL=https://api.orangesmspro.sn:8443/api
ORANGE_LOGIN=
ORANGE_API_KEY=
ORANGE_TOKEN=
# Sujet et signature (nom d'expéditeur) enregistrés chez Orange SMS Pro
ORANGE_SUBJECT=
ORANGE_SIGNATURE=

# --- Notifications push (Web Push, clés VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
