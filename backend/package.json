{
  "name": "calebasse-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Backend Supabase de Calebasse de l'Espoir (PWA Tontine)",
  "scripts": {
    "start": "supabase start",
    "stop": "supabase stop",
    "status": "supabase status",
    "reset": "supabase db reset",
    "migration:new": "supabase migration new",
    "functions": "supabase functions serve --env-file supabase/functions/.env",
    "types": "supabase gen types typescript --local > ../tontine-pwa/src/types/database.ts",
    "test:db": "supabase test db",
    "lint:db": "supabase db lint"
  },
  "devDependencies": {
    "supabase": "^2.122.1"
  }
}
